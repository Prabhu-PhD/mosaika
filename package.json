{
  "name": "project-bento",
  "version": "0.1.0",
  "private": true,
  "description": "Bounded, non-destructive Bento Grid layout engine for Microsoft PowerPoint",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "test:core": "pnpm --filter @bento/core test",
    "typecheck": "pnpm -r --if-present typecheck",
    "dev:harness": "pnpm --filter @bento/browser-harness dev",
    "build:vsto": "powershell -ExecutionPolicy Bypass -File hosts/windows-vsto/scripts/build-vsto.ps1 -Configuration Release",
    "package:vsto": "powershell -ExecutionPolicy Bypass -File hosts/windows-vsto/scripts/package-installer.ps1",
    "clean": "pnpm -r --if-present clean"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
